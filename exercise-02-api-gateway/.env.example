# Copy to .env, then replace every CHANGE_ME value.
# Generate JWT_SECRET with: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_WITH_AT_LEAST_32_RANDOM_CHARACTERS
JWT_ISSUER=security-patterns-lab
JWT_AUDIENCE=api-gateway
JWT_TTL_SECONDS=900

DEMO_USER_EMAIL=student@example.test
DEMO_USER_PASSWORD=CHANGE_ME_DEMO_PASSWORD

MINIO_ROOT_USER=CHANGE_ME_MINIO_USER
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_PASSWORD_AT_LEAST_8_CHARS
MINIO_BUCKET=avatars
MINIO_PUBLIC_HOST=localhost
MINIO_PUBLIC_PORT=9000

